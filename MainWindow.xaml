<Window x:Class="MusicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicIsland"
        Width="560"
        Height="300"
        Left="0"
        Top="0"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Round, borderless icon button with a soft highlight and press squish -->
        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Highlight"
                                     Fill="White"
                                     Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.86" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.86" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            The island is ONE black shape: no outline, no drop shadow (both used to
            show up as a box around the pill). Size, corner radius and clip are
            driven every frame by springs in code-behind; the content panels below
            have fixed sizes and are revealed by the shape instead of re-flowing.
        -->
        <Grid x:Name="IslandContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,10,0,0"
              Width="236"
              Height="38"
              RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter"
              MouseLeave="Island_MouseLeave"
              MouseWheel="Island_MouseWheel">

            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale"/>
            </Grid.RenderTransform>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings…" Click="Settings_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit MusicIsland" Click="Quit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Border x:Name="IslandShape"
                    Background="Black"
                    CornerRadius="19"/>

            <Grid x:Name="IslandContent">

                <!-- Album-tinted glow behind the expanded card -->
                <Border x:Name="ExpandedGlow"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <!-- ===== Compact: music ===== -->
                <Grid x:Name="CompactMusic"
                      Width="236"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Border Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            CornerRadius="7"
                            Background="#1C1C1E"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,24,24" RadiusX="7" RadiusY="7"/>
                        </Border.Clip>
                        <Image x:Name="CompactAlbumArt"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel x:Name="CompactBars"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="0,0,14,0"/>
                </Grid>

                <!-- ===== Compact: clock / weather ===== -->
                <Grid x:Name="CompactAmbient"
                      Width="210"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <TextBlock x:Name="CompactTime"
                               Text="10:42"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock x:Name="CompactAmbientGlyph"
                                   FontFamily="{StaticResource IconFont}"
                                   Foreground="#FFD60A"
                                   FontSize="13"
                                   Margin="0,1,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactAmbientText"
                                   Text="Wed 29"
                                   Foreground="#B3FFFFFF"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Compact: volume pill ===== -->
                <Grid x:Name="CompactVolume"
                      Width="264"
                      Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactVolumeGlyph"
                               Text="&#xE995;"
                               FontFamily="{StaticResource IconFont}"
                               Foreground="White"
                               FontSize="14"
                               Margin="16,0,10,0"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Column="1"
                          Height="5"
                          VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                        <Border x:Name="CompactVolumeFill"
                                Background="White"
                                CornerRadius="2.5"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>

                    <TextBlock x:Name="CompactVolumeText"
                               Grid.Column="2"
                               Text="50"
                               Foreground="#B3FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Width="26"
                               TextAlignment="Right"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Camera notch (idle) ===== -->
                <Grid x:Name="NotchPanel"
                      Width="112"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Ellipse Width="11"
                             Height="11"
                             Margin="0,0,11,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#2A2F45" Offset="0"/>
                                <GradientStop Color="#10121C" Offset="0.6"/>
                                <GradientStop Color="#050508" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="2.5"
                             Height="2.5"
                             Margin="0,0,15.5,3"
                             Fill="#556A7BFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== Peek: new song ===== -->
                <Grid x:Name="PeekMusic"
                      Width="340"
                      Height="64"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Margin="12,0,0,0"
                            CornerRadius="11"
                            Background="#1C1C1E">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,44,44" RadiusX="11" RadiusY="11"/>
                        </Border.Clip>
                        <Image x:Name="PeekArt"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0,10,0">
                        <TextBlock x:Name="PeekTitle"
                                   Foreground="White"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekArtist"
                                   Foreground="#99FFFFFF"
                                   FontSize="12"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel x:Name="PeekBars"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="0,0,20,0"/>
                </Grid>

                <!-- ===== Peek: chat message / update ===== -->
                <Grid x:Name="PeekNotify"
                      Width="370"
                      Height="76"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseLeftButtonUp="Notify_Click"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="44"
                          Height="44"
                          Margin="14,0,0,0">
                        <Border x:Name="NotifyBadge"
                                CornerRadius="12"
                                Background="#5865F2">
                            <TextBlock x:Name="NotifyBadgeGlyph"
                                       Text="&#xE8BD;"
                                       FontFamily="{StaticResource IconFont}"
                                       Foreground="White"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border>
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,44,44" RadiusX="12" RadiusY="12"/>
                            </Border.Clip>
                            <Image x:Name="NotifyIcon"
                                   Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0,20,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="now"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="NotifyApp"
                                       Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <TextBlock x:Name="NotifySender"
                                   Foreground="White"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifyMessage"
                                   Foreground="#B3FFFFFF"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Expanded: music ===== -->
                <Grid x:Name="ExpandedMusic"
                      Width="400"
                      Height="172"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Grid Margin="22,20,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Art, title, live bars -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="13"
                                    Background="#1C1C1E">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,56,56" RadiusX="13" RadiusY="13"/>
                                </Border.Clip>
                                <Grid>
                                    <TextBlock Text="&#xE8D6;"
                                               FontFamily="{StaticResource IconFont}"
                                               Foreground="#40FFFFFF"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image x:Name="AlbumArt"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,12,0">
                                <Border x:Name="TitleClip"
                                        ClipToBounds="True">
                                    <TextBlock x:Name="TrackTitle"
                                               Text="Not playing"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="TrackTitle_Click"
                                               ToolTip="Open album in Spotify">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="TitleTransform"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>

                                <TextBlock x:Name="TrackArtist"
                                           Text="Play something to get started"
                                           Foreground="#99FFFFFF"
                                           FontSize="13"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="TrackArtist_Click"
                                           ToolTip="Open artist in Spotify"/>
                            </StackPanel>

                            <StackPanel x:Name="ExpandedBars"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Height="26"/>
                        </Grid>

                        <!-- Current synced lyric line -->
                        <Border x:Name="LyricRow"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Height="20"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LyricText"
                                       Foreground="#E6FFFFFF"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LyricShift"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>

                        <!-- Progress (drag to seek), or volume while scrolling -->
                        <Grid Grid.Row="2"
                              Margin="0,14,0,0"
                              Height="16">

                            <Grid x:Name="ProgressRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ElapsedText"
                                           Text="0:00"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>

                                <Grid x:Name="ProgressTrack"
                                      Grid.Column="1"
                                      Height="16"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="Seek_MouseDown"
                                      MouseMove="Seek_MouseMove"
                                      MouseLeftButtonUp="Seek_MouseUp"
                                      LostMouseCapture="Seek_LostCapture">
                                    <Grid x:Name="ProgressBar"
                                          Height="5"
                                          VerticalAlignment="Center">
                                        <Border Background="#2EFFFFFF" CornerRadius="4"/>
                                        <Border x:Name="ProgressFill"
                                                Background="#E6FFFFFF"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                Width="0"/>
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="RemainingText"
                                           Grid.Column="2"
                                           Text="-0:00"
                                           Style="{StaticResource Caption}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid x:Name="VolumeRow"
                                  Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="VolumeRowGlyph"
                                           Text="&#xE995;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#CCFFFFFF"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>

                                <Grid x:Name="VolumeTrack"
                                      Grid.Column="1"
                                      Height="5"
                                      VerticalAlignment="Center">
                                    <Border Background="#2EFFFFFF" CornerRadius="2.5"/>
                                    <Border x:Name="VolumeRowFill"
                                            Background="White"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Left"
                                            Width="0"/>
                                </Grid>

                                <TextBlock x:Name="VolumeRowText"
                                           Grid.Column="2"
                                           Text="50%"
                                           Style="{StaticResource Caption}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Controls -->
                        <Grid Grid.Row="3"
                              VerticalAlignment="Center"
                              Margin="0,6,0,0">

                            <!-- Where the music comes from (shown when there's no heart) -->
                            <StackPanel x:Name="SourceLabel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="SourceGlyph"
                                           Text="&#xE774;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#8CFFFFFF"
                                           FontSize="12"
                                           Margin="0,1,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="SourceText"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid x:Name="HeartSlot"
                                  HorizontalAlignment="Left"
                                  Width="40"
                                  Height="40">
                                <Ellipse x:Name="HeartRing"
                                         Stroke="#FF375F"
                                         StrokeThickness="2"
                                         Opacity="0"
                                         IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="HeartRingScale"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Button x:Name="HeartButton"
                                        Style="{StaticResource IconButton}"
                                        Click="Heart_Click"
                                        ToolTip="Add to Liked Songs">
                                    <TextBlock x:Name="HeartGlyph"
                                               Text="&#xEB51;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="17"
                                               Foreground="#CCFFFFFF"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform x:Name="HeartScale"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="&#xE892;"
                                        Click="Previous_Click"
                                        Style="{StaticResource IconButton}"
                                        FontSize="17"
                                        ToolTip="Previous"/>

                                <Button x:Name="PlayPauseButton"
                                        Content="&#xE768;"
                                        Click="PlayPause_Click"
                                        Style="{StaticResource IconButton}"
                                        Width="46"
                                        Height="46"
                                        FontSize="24"
                                        Margin="18,0"/>

                                <Button Content="&#xE893;"
                                        Click="Next_Click"
                                        Style="{StaticResource IconButton}"
                                        FontSize="17"
                                        ToolTip="Next"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Content="&#xE713;"
                                    Click="Settings_Click"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#80FFFFFF"
                                    FontSize="15"
                                    ToolTip="Settings"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Expanded: ambient (nothing playing) ===== -->
                <Grid x:Name="ExpandedAmbient"
                      Width="400"
                      Height="150"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>

                    <Grid Margin="26,20,22,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AmbientTime"
                                       Text="10:42"
                                       Foreground="White"
                                       FontSize="40"
                                       FontWeight="Light"/>
                            <TextBlock x:Name="AmbientDate"
                                       Text="Wednesday, October 29"
                                       Foreground="#99FFFFFF"
                                       FontSize="13"
                                       Margin="2,-2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="AmbientWeather"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock x:Name="AmbientWeatherGlyph"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="#FFD60A"
                                           FontSize="24"
                                           Margin="0,4,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AmbientTemp"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Light"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="AmbientWeatherText"
                                       Foreground="#99FFFFFF"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <DockPanel Grid.Row="1"
                                   LastChildFill="False">
                            <TextBlock Text="Nothing playing"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"/>

                            <Button DockPanel.Dock="Right"
                                    Content="&#xE713;"
                                    Click="Settings_Click"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#80FFFFFF"
                                    FontSize="14"
                                    Width="32"
                                    Height="32"
                                    ToolTip="Settings"/>

                            <Button DockPanel.Dock="Right"
                                    Click="OpenSpotify_Click"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Margin="0,0,6,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Pill"
                                                Background="#1ED760"
                                                CornerRadius="14"
                                                Padding="14,6">
                                            <TextBlock Text="Open Spotify"
                                                       Foreground="Black"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="#3BE477"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
